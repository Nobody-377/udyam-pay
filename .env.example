# Copy to .env and replace every placeholder. NEVER commit .env.
# All values below are placeholders for LOCAL DEVELOPMENT ONLY.

# --- Application ---------------------------------------------------------
NODE_ENV=development
# Provider mode: 'mock' (JSON demo fixtures) | 'sandbox' | 'production'
# In production, 'mock' is strictly rejected.
PROVIDER_MODE=mock
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development only (must be false in production)
LOG_PRETTY=true
# Number of reverse-proxy hops to trust for client IPs (0 = none). Set to 1
# behind a single load balancer so rate limiting sees real client IPs.
TRUST_PROXY=0

# --- HTTP hardening --------------------------------------------------------
# Comma-separated exact origins allowed for browser access (no wildcard, no
# trailing slash). Leave empty to allow no browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Security & JWT -------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-chars-crypto-secret-key-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30
WEBHOOK_DEFAULT_TOLERANCE_SECONDS=300
# Development-only fallback secret for mock lenders. Must NEVER be set in production!
DEV_DEFAULT_WEBHOOK_SECRET=lender-default-dev-secret

# Individual lender secrets (referenced by LenderConfiguration.secretRef in database)
LENDER_ALPHA_WEBHOOK_SECRET=alpha-dev-test-secret-key-32chars
LENDER_BETA_WEBHOOK_SECRET=beta-dev-test-secret-key-32chars

# --- PostgreSQL (used by docker-compose.yml) ---------------------------------
POSTGRES_USER=udhyam
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=udhyam_pay
POSTGRES_PORT=5432

# Must match the values above. If the password contains special characters
# (@ : / ? # %) it must be URL-encoded inside this URL.
DATABASE_URL=postgresql://udhyam:change-me-local-only@localhost:5432/udhyam_pay?schema=public
